#!/usr/bin/env bash
#===============================================================================
# Wazuh Quadlet Teardown Script
# Removes all resources created by wazuh-deploy: services, containers, volumes,
# network, certs, configs, fix script, sysctl tuning, and firewall rules.
# Does NOT touch the wazuh-deploy script itself.
#===============================================================================
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

log()  { echo -e "${GREEN}[✔]${NC} $1"; }
warn() { echo -e "${YELLOW}[!]${NC} $1"; }
step() { echo -e "\n${CYAN}===> $1${NC}"; }

[[ $EUID -ne 0 ]] && { echo -e "${RED}[✘]${NC} Must be run as root."; exit 1; }

#---------------------------------------
# STOP SERVICES
#---------------------------------------
step "Stopping Wazuh services"

for svc in wazuh-dashboard wazuh-manager wazuh-indexer; do
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
        systemctl stop "$svc" && log "Stopped $svc" || warn "Failed to stop $svc (may already be stopped)"
    else
        warn "$svc already stopped"
    fi
done

#---------------------------------------
# REMOVE QUADLET UNIT FILES
#---------------------------------------
step "Removing Quadlet unit files"

for f in \
    /etc/containers/systemd/wazuh-indexer.container \
    /etc/containers/systemd/wazuh-manager.container \
    /etc/containers/systemd/wazuh-dashboard.container \
    /etc/containers/systemd/wazuh.network \
    /etc/containers/systemd/wazuh-indexer-data.volume \
    /etc/containers/systemd/wazuh-manager-data.volume \
    /etc/containers/systemd/wazuh-manager-etc.volume \
    /etc/containers/systemd/wazuh-manager-logs.volume \
    /etc/containers/systemd/wazuh-dashboard-config.volume; do
    if [[ -f "$f" ]]; then
        rm -f "$f" && log "Removed $f"
    fi
done

systemctl daemon-reload
# Stop any wazuh volume units still in active/exited state in systemd's runtime
# memory (unit files removed but not yet stopped — shows as "not-found active exited")
for stale in wazuh-dashboard-config-volume wazuh-indexer-data-volume \
             wazuh-manager-data-volume wazuh-manager-etc-volume wazuh-manager-logs-volume; do
    systemctl stop "$stale" 2>/dev/null || true
done
systemctl reset-failed 'wazuh-*' 2>/dev/null || true
log "systemd reloaded and stale units cleared"

#---------------------------------------
# REMOVE CONTAINERS
#---------------------------------------
step "Removing containers"

for c in wazuh.indexer wazuh.manager wazuh.dashboard; do
    if podman container exists "$c" 2>/dev/null; then
        podman rm -f "$c" && log "Removed container $c"
    else
        warn "Container $c not found"
    fi
done

#---------------------------------------
# REMOVE VOLUMES
#---------------------------------------
step "Removing volumes"

for v in wazuh-indexer-data wazuh-manager-data wazuh-manager-etc wazuh-manager-logs wazuh-dashboard-config; do
    if podman volume exists "$v" 2>/dev/null; then
        podman volume rm "$v" && log "Removed volume $v"
    else
        warn "Volume $v not found"
    fi
done

#---------------------------------------
# REMOVE NETWORK
#---------------------------------------
step "Removing Podman network"

if podman network exists systemd-wazuh 2>/dev/null; then
    podman network rm systemd-wazuh && log "Removed network systemd-wazuh"
else
    warn "Network systemd-wazuh not found"
fi

#---------------------------------------
# REMOVE CERTS, CONFIGS, FIX SCRIPT
#---------------------------------------
step "Removing certs, configs, and fix script"

for path in /etc/wazuh-certs /etc/wazuh-config /var/lib/wazuh; do
    if [[ -e "$path" ]]; then
        rm -rf "$path" && log "Removed $path"
    fi
done

if [[ -f /usr/local/bin/wazuh-fix-ossec ]]; then
    rm -f /usr/local/bin/wazuh-fix-ossec && log "Removed /usr/local/bin/wazuh-fix-ossec"
fi

#---------------------------------------
# REMOVE SYSCTL TUNING
#---------------------------------------
step "Removing sysctl tuning"

if [[ -f /etc/sysctl.d/99-wazuh.conf ]]; then
    rm -f /etc/sysctl.d/99-wazuh.conf && log "Removed /etc/sysctl.d/99-wazuh.conf"
    sysctl --system &>/dev/null
    log "sysctl reloaded"
fi

#---------------------------------------
# UNDO FIREWALL RULES
#---------------------------------------
step "Removing firewall rules"

if command -v firewall-cmd &>/dev/null && systemctl is-active --quiet firewalld; then
    for port in 443/tcp 1514/tcp 1515/tcp 514/udp 55000/tcp; do
        firewall-cmd --permanent --remove-port="$port" &>/dev/null && log "Removed port $port" || warn "Port $port was not open"
    done
    firewall-cmd --permanent --zone=trusted --remove-masquerade &>/dev/null && log "Removed masquerade from trusted zone" || warn "Masquerade was not set"
    firewall-cmd --reload &>/dev/null
    log "Firewall reloaded"
else
    warn "firewalld not running — skipping firewall cleanup"
fi

#---------------------------------------
# VERIFY
#---------------------------------------
step "Verification"

echo ""
echo "Remaining wazuh systemd units:"
systemctl list-units 'wazuh*' 2>/dev/null || echo "  (none)"

echo ""
echo "Remaining wazuh containers:"
podman ps -a --filter label=project=wazuh-siem 2>/dev/null || echo "  (none)"

echo ""
log "Teardown complete."
