{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "DenyCloudtrailDisable",
            "Effect": "Deny",
            "Action": [
                "cloudtrail:DeleteTrail",
                "cloudtrail:StopLogging",
                "cloudtrail:UpdateTrail"],
            "Resource": "*",
            "Condition": {
            "StringNotLike": {
                "aws:PrincipalArn": "arn:aws:iam::*:role/SecurityAdmin"

                }
            }

        }
    ]
}
