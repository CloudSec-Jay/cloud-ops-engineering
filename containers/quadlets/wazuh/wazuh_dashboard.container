[Unit]
Description=Wazuh Dashboard (OpenSearch Dashboards)
Documentation=https://documentation.wazuh.com/current/deployment-options/docker/index.html
After=network-online.target wazuh-indexer.service wazuh-manager.service
Wants=network-online.target
Requires=wazuh-indexer.service wazuh-manager.service

[Container]
Image=wazuh/wazuh-dashboard:4.9.0
ContainerName=wazuh.dashboard

Network=wazuh.network
HostName=wazuh.dashboard

# Dashboard — HTTPS only on all interfaces (put nginx/caddy in front for production)
PublishPort=443:5601

# opensearch_dashboards.yml — TLS config, indexer connection, session settings
Volume=/etc/wazuh/config/opensearch_dashboards.yml:/usr/share/wazuh-dashboard/config/opensearch_dashboards.yml:ro,z

# wazuh.yml — Wazuh API credentials for the dashboard plugin
# Generated by deploy-wazuh.sh at /etc/wazuh/wazuh.yml (not in git — contains API password)
Volume=/etc/wazuh/wazuh.yml:/usr/share/wazuh-dashboard/data/wazuh/config/wazuh.yml:z

# TLS certificates — target paths must match opensearch_dashboards.yml
Volume=/etc/wazuh/certs/root-ca.pem:/usr/share/wazuh-dashboard/certs/root-ca.pem:ro,z
Volume=/etc/wazuh/certs/wazuh.dashboard.pem:/usr/share/wazuh-dashboard/certs/wazuh-dashboard.pem:ro,z
Volume=/etc/wazuh/certs/wazuh.dashboard-key.pem:/usr/share/wazuh-dashboard/certs/wazuh-dashboard-key.pem:ro,z

# Entrypoint (wazuh_app_config.sh) reads these and passes them as CLI args to the
# node process, which OVERRIDES opensearch_dashboards.yml. Must be set explicitly.
EnvironmentFile=/etc/wazuh/secrets.env
Environment=OPENSEARCH_HOSTS=https://wazuh.indexer:9200
Environment=WAZUH_API_URL=https://wazuh.manager
Environment=SERVER_SSL_ENABLED=true
Environment=SERVER_SSL_CERTIFICATE=/usr/share/wazuh-dashboard/certs/wazuh-dashboard.pem
Environment=SERVER_SSL_KEY=/usr/share/wazuh-dashboard/certs/wazuh-dashboard-key.pem
Environment=OPENSEARCH_SSL_VERIFICATIONMODE=certificate
Environment=OPENSEARCH_SSL_CERTIFICATEAUTHORITIES=/usr/share/wazuh-dashboard/certs/root-ca.pem

Label=project=wazuh-siem
Label=component=dashboard

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target default.target
