[Unit]
Description=Wazuh Manager (includes Filebeat for indexer ingestion)
Documentation=https://documentation.wazuh.com/current/deployment-options/docker/index.html
After=network-online.target wazuh-indexer.service
Wants=network-online.target
Requires=wazuh-indexer.service

[Container]
Image=wazuh/wazuh-manager:4.9.0
ContainerName=wazuh.manager

Network=wazuh.network
HostName=wazuh.manager

# Agent registration (1514 UDP/TCP), agent enrollment (1515), syslog (514 UDP)
# API (55000) — loopback only; dashboard accesses via internal quadlet network
PublishPort=1514:1514
PublishPort=1515:1515
PublishPort=514:514/udp
PublishPort=127.0.0.1:55000:55000

# Persistent volumes — rules, decoders, config, logs survive container rebuild
Volume=wazuh-manager-etc.volume:/var/ossec/etc:z
Volume=wazuh-manager-logs.volume:/var/ossec/logs:z
Volume=wazuh-manager-queue:/var/ossec/queue:z
Volume=wazuh-manager-integrations:/var/ossec/integrations:z
Volume=wazuh-manager-active-response:/var/ossec/active-response/bin:z
Volume=wazuh-manager-agentless:/var/ossec/agentless:z
Volume=wazuh-manager-wodles:/var/ossec/wodles:z
Volume=wazuh-manager-api-config:/var/ossec/api/configuration:z

# Filebeat volumes (pre-installed in wazuh-manager image)
Volume=wazuh-filebeat-etc:/etc/filebeat:z
Volume=wazuh-filebeat-var:/var/lib/filebeat:z

# TLS certificates for Filebeat → Indexer mTLS
Volume=/etc/wazuh/certs/root-ca.pem:/etc/ssl/root-ca.pem:ro,z
Volume=/etc/wazuh/certs/wazuh.manager.pem:/etc/ssl/filebeat.pem:ro,z
Volume=/etc/wazuh/certs/wazuh.manager-key.pem:/etc/ssl/filebeat.key:ro,z

# Indexer connection + API credentials from secrets file (root:root 0600)
EnvironmentFile=/etc/wazuh/secrets.env
Environment=INDEXER_URL=https://wazuh.indexer:9200
Environment=FILEBEAT_SSL_VERIFICATION_MODE=full
Environment=SSL_CERTIFICATE_AUTHORITIES=/etc/ssl/root-ca.pem
Environment=SSL_CERTIFICATE=/etc/ssl/filebeat.pem
Environment=SSL_KEY=/etc/ssl/filebeat.key

Label=project=wazuh-siem
Label=component=manager

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target default.target
