# Wazuh secrets — copy to /etc/wazuh/secrets.env, set mode 0600, root:root
# DO NOT commit the populated file to git (.gitignore covers *.env)
#
# Generate strong passwords:  openssl rand -base64 32

# Indexer (OpenSearch) credentials
INDEXER_USERNAME=admin
INDEXER_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Wazuh API credentials (used by dashboard to query manager)
API_USERNAME=wazuh-wui
API_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Dashboard internal service account (OpenSearch Dashboards → OpenSearch)
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=CHANGE_ME_STRONG_PASSWORD
