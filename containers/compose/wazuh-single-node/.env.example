# AWS credentials for Wazuh aws-s3 wodle
# Copy to .env and fill in real values — .env is gitignored
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Required Wazuh credentials. These must match regenerated hashes in
# config/wazuh_indexer/internal_users.yml.
INDEXER_PASSWORD=
API_PASSWORD=
DASHBOARD_PASSWORD=
